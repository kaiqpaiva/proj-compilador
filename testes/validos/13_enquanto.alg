algoritmo "Enquanto"
var
i, j, soma: inteiro
inicio
i <- 1
soma <- 0
enquanto i <= 5 faca
   soma <- soma + i
   i <- i + 1
fimenquanto
escreval(soma)
i <- 1
enquanto i <= 3 faca
   j <- 1
   enquanto j <= i faca
      escreva(j)
      j <- j + 1
   fimenquanto
   i <- i + 1
fimenquanto
enquanto 0 > 1 faca
   escreval(99)
fimenquanto
fimalgoritmo
