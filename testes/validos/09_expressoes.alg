algoritmo "Expressoes"
var
a, b, x1, x2, x3, x4, x5: inteiro
r1, r2: real
l1, l2: logico
inicio
a <- 7
b <- 2
x1 <- 2 + 3 * 4
x2 <- (2 + 3) * 4
x3 <- 10 - 4 - 3
x4 <- -a + b
x5 <- a \ b
r1 <- a / b
r2 <- 1.5 * 2
l1 <- (a > b) e (b > 5)
l2 <- (a > b) ou (b > 5)
escreval(x1, x2, x3, x4, x5, r1, r2, l1, l2)
fimalgoritmo
