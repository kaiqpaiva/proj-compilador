algoritmo "ParqueDeDiversoes"
var
idade: inteiro
altura: real
podeBrincar: logico
inicio
idade <- 14
altura <- 1.60
podeBrincar <- (idade >= 12) E (altura >= 1.50)
escreval("Pode entrar na Montanha Russa? ", podeBrincar)
escreval("Divisao inteira: ", idade \ 3, " resto: ", idade MOD 3)
escreval("Diferente? ", idade <> 15)
fimalgoritmo
